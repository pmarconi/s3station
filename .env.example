# Login
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# HTTP
HTTP_ADDR=:8080
COOKIE_SECURE=false

# Postgres listing cache (overridden in docker compose)
DATABASE_URL=postgres://station:station@localhost:5432/station?sslmode=disable

# Redis sessions (overridden in docker compose)
REDIS_URL=redis://localhost:6379/0

# Your existing AWS S3 bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Leave empty for real AWS. Only set these for a custom S3-compatible endpoint.
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_USE_PATH_STYLE=false

# Uploads
MAX_UPLOAD_BYTES=5368709120
PRESIGN_TTL=15m
