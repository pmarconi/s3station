package views

templ BusyOverlay() {
	<dialog id="page-busy" class="modal">
		<div class="modal-box flex max-w-xs flex-col items-center gap-3">
			<span class="loading loading-spinner loading-lg text-primary"></span>
			<span class="text-sm text-base-content/70">Working…</span>
		</div>
	</dialog>
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="night">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/app.build.css"/>
		</head>
		<body class="bg-base-200">
			{ children... }
			<script src="/static/js/upload.js"></script>
			<script src="/static/js/gallery.js"></script>
			<script src="/static/js/nav.js"></script>
			<script type="module" src="/static/js/datastar.js"></script>
		</body>
	</html>
}
